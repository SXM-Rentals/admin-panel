# WHAT THIS FILE DOES: Lists the settings the panel needs in order to run, so
# somebody setting it up on a new machine knows what to fill in. Copy it to
# ".env.local" and put the real value in. The copy is never committed.
#
# The address of the SXM Rentals server. There is deliberately no NEXT_PUBLIC_
# prefix: the address is used when the panel passes a request on, and is never
# sent to anybody's browser. The same value goes into Vercel's own settings
# (Settings -> Environment Variables) for the deployed panel.
API_URL=https://sxm-rentals-api.onrender.com
